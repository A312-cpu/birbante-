<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="#17191F" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:padding="14dp" android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="Birbante" android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
        <Button android:id="@+id/locationButton" android:text="📍 POSIZIONE" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>
    <org.maplibre.android.maps.MapView android:id="@+id/mapView" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
    <LinearLayout android:padding="12dp" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:id="@+id/status" android:text="Premi POSIZIONE per autorizzare e rilevare il GPS." android:textColor="#C9CCD4" android:padding="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
            <EditText android:id="@+id/searchInput" android:hint="bar, ristorante, pizzeria…" android:textColor="#FFFFFF" android:textColorHint="#969BA7" android:backgroundTint="#555965" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
            <Button android:id="@+id/searchButton" android:text="CERCA" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
        <ScrollView android:layout_width="match_parent" android:layout_height="180dp"><LinearLayout android:id="@+id/results" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content"/></ScrollView>
    </LinearLayout>
</LinearLayout>
